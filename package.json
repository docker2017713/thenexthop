{
  "name": "synology-music-player",
  "version": "0.1.0",
  "private": false,
  "description": "Cross-platform desktop client for Synology Music Player with enhanced system integration.",
  "author": "Albert",
  "license": "MIT",
  "homepage": "https://github.com/thenexthop2025/SynologyMusicPlayer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenexthop2025/SynologyMusicPlayer.git"
  },
  "bugs": {
    "url": "https://github.com/thenexthop2025/SynologyMusicPlayer/issues"
  },
  "keywords": [
    "synology",
    "music",
    "player",
    "desktop",
    "electron",
    "react",
    "audio",
    "nas"
  ],
  "main": "dist/main/main.cjs",
  "scripts": {
    "dev": "concurrently \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:preload\" \"npm:dev:electron\"",
    "dev:renderer": "vite --config electron/vite.renderer.config.ts",
    "dev:main": "NODE_ENV=development vite build --config electron/vite.main.config.ts --watch",
    "dev:preload": "vite build --config electron/vite.preload.config.ts --watch",
    "dev:electron": "wait-on tcp:5173 && NODE_ENV=development electron .",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer && npm run copy:assets",
    "copy:assets": "cp -r assets dist/",
    "build:main": "vite build --config electron/vite.main.config.ts",
    "build:preload": "vite build --config electron/vite.preload.config.ts",
    "build:renderer": "vite build --config electron/vite.renderer.config.ts",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:all": "npm run build && electron-builder --mac --win --linux",
    "pack": "npm run build && electron-builder --dir",
    "pack:mac": "npm run build && electron-builder --dir --mac",
    "pack:win": "npm run build && electron-builder --dir --win"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "keytar": "^7.9.0",
    "node-fetch": "^2.6.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/node-fetch": "^2.6.4",
    "@types/react": "^18.2.24",
    "@types/react-dom": "^18.2.10",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^22.3.27",
    "electron-builder": "^24.10.4",
    "typescript": "^5.4.5",
    "vite": "^5.2.7",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.synology.music-player",
    "productName": "Synology Music Player",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "assets/appIcon.icns",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSExceptionDomains": {
            "localhost": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSExceptionMinimumTLSVersion": "1.0",
              "NSIncludesSubdomains": true
            },
            "*.local": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSExceptionMinimumTLSVersion": "1.0",
              "NSIncludesSubdomains": true
            }
          }
        }
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/appIcon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/appIcon.png",
      "category": "AudioVideo"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
